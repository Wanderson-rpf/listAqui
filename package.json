{
  "name": "listaqui",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:lan": "ng serve --host 0.0.0.0 --allowed-hosts",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href=/listAqui/",
    "serve:dist": "npx --yes http-server dist/listaqui/browser -p 4321 -s --host 0.0.0.0",
    "preview": "npm run build && npm run serve:dist",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "node e2e-smoke.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/pwa": "^21.2.22",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.22",
    "@ionic/angular": "^9.0.1",
    "dexie": "^4.4.5",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "description": "Lista de compras com controle de gastos e historico de precos. PWA offline-first."
}
